# ==== LLM ====
ANTHROPIC_API_KEY=sk-ant-xxxxx
OPENAI_API_KEY=

# ==== Modelos ====
CLAUDE_MODEL_ROUTINE=claude-sonnet-4-6
CLAUDE_MODEL_COMPLEX=claude-opus-4-6

# ==== Postgres ====
PG_HOST=postgres
PG_PORT=5432
PG_DB=dsagents
PG_USER=dsagents
PG_PASSWORD=change_me

# ==== MinIO ====
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_too
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=dsagents

# ==== Kestra ====
KESTRA_DB_URL=jdbc:postgresql://postgres:5432/dsagents

# ==== Sandbox ====
SANDBOX_TIMEOUT_SECONDS=300
SANDBOX_MEMORY_LIMIT=2g
SANDBOX_CPU_LIMIT=2
SANDBOX_IMAGE=ds-agents-sandbox:latest

# ==== Geral ====
ENVIRONMENT=development
LOG_LEVEL=INFO
AGENT_CORE_PORT=8000
